rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /trips/{tripId} {
      // Membros existentes: leitura, edição e remoção livres.
      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      // Criar viagem: só em nome próprio, e já como membro dela.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.memberIds;

      // Entrar via link de convite: quem ainda não é membro só pode fazer um
      // pedido que (a) envie o código certo no campo joinCode, comparado com o
      // inviteCode verdadeiro guardado na viagem, (b) se adicione a si próprio
      // a memberIds/members, e (c) não mexa em mais nenhum outro campo.
      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.joinCode == resource.data.inviteCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'joinCode']);

      match /expenses/{expenseId} {
        // Só um membro da viagem pode ler/escrever despesas dentro dela.
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
      }
    }
  }
}
