rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /trips/{tripId} {
      // Qualquer membro da viagem (não só o dono) pode ler, editar ou apagar.
      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      // Só se pode criar uma viagem em próprio nome, e já como membro dela.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.memberIds;

      // Entrar via link de convite: quem ainda não é membro só pode fazer um
      // pedido que (a) mantenha o mesmo inviteCode, (b) se adicione a si próprio
      // a memberIds/members, e (c) não mexa em mais nenhum campo da viagem.
      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members']);

      match /expenses/{expenseId} {
        // Só um membro da viagem pode ler/escrever despesas dentro dela.
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
      }
    }
  }
}
